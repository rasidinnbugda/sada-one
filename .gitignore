# Kuruluma özel yapılandırma — asla depoya girmez
config.php

# Kullanıcı yüklemeleri (koruyucu dosyalar hariç)
uploads/*
!uploads/.htaccess
!uploads/index.html

# Yedekler (panel içi güncelleyici üretir)
backups/*
!backups/.htaccess
!backups/index.html

# Paket ve geçici dosyalar
*.zip
tani.php
error_log

# Google servis anahtarı — asla depoya/pakete girmez
storage/*.json
storage/*.log
